# Copy to .env and fill in. All values below are placeholders (RFC 1918 / RFC 5737 style).

# Recommended (random per-process if unset). Generate one:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# 1 for local development, unset/0 otherwise
DJANGO_DEBUG=1

# Comma-separated
ALLOWED_HOSTS=127.0.0.1,localhost

# Hosts the API impersonates / listens on (user/system API and game API)
ENV_HOST=192.0.2.10
PRD_HOST=192.0.2.11

# Diarkis RUDP matchmaking server (RUDPserver.py, UDP)
UDP_HOST=192.0.2.12
UDP_PORT=7100
# Session host port handed out once a match is found
UDP_SESSION_PORT=7102

# Local STUN server handed out by battle/get_stun_server_info
STUN_HOST=192.0.2.13
STUN_PORTS=3478,3479

# Path to the adjustment-data blob served by adjustment_data_manage/read.
# Not committed to this repo; export it from your own install.
ADJUSTMENT_DATA_PATH=

# Diarkis session keys are FRESH PER SESSION by default (issued by the HTTP
# handout endpoints, shared with the UDP peer via diarkis_peer.KEY_REGISTRY).
# Dev override: uncomment to pin a fixed key set (standalone RUDPserver.py
# mode registers it so a dev client can connect without the HTTP layer).
#DIARKIS_SID_KEY=00000000000000000000000000000000
#DIARKIS_AES_KEY=00000000000000000000000000000000
#DIARKIS_IV_KEY=00000000000000000000000000000000
#DIARKIS_HASH_KEY=00000000000000000000000000000000

# Diarkis UDP peer payload strings (all .invalid / RFC 5737 placeholders):
# DIARKIS_PUSH_ADDRS — the two 0x012f "server address" pushes after bootstrap
# DIARKIS_REDIRECT_ADDR — 0x0002 redirect target answered by the probe listener
# DIARKIS_DIRECTORY_ADDR — cleartext 0x0c0c directory answer (session host)
DIARKIS_PUSH_ADDRS=192.0.2.12.example.invalid:7100,192.0.2.12.example.invalid:7099
DIARKIS_REDIRECT_ADDR=192.0.2.12.example.invalid:7100
DIARKIS_DIRECTORY_ADDR=192.0.2.13.example.invalid:7102
